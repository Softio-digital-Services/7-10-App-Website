generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String           @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          Role             @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  comments      Comment[]
  requests      ProductRequest[] @relation("MemberRequests")
  managedRequests ProductRequest[] @relation("ManagerRequests")
  stockAlerts   StockNotification[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String              @id @default(cuid())
  externalId    String?             @unique
  name          String
  nameAr        String?
  slug          String              @unique
  description   String
  descriptionAr String?
  price         Float
  cost          Float               @default(0)
  discount      Float               @default(0)
  imageUrl      String
  /// JSON array of extra gallery image URLs
  images        String              @default("[]")
  colorName     String?
  featured      Boolean             @default(false)
  category      String
  categoryId    String?
  categoryRef   Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  active        Boolean             @default(true)
  variants    ProductVariant[]
  comments    Comment[]
  requests    ProductRequest[]
  stockAlerts StockNotification[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ProductVariant {
  id              String      @id @default(cuid())
  externalId      String?     @unique
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size            String
  color           String
  stock           Int         @default(0)
  lowStockAlert   Boolean     @default(false)
  outOfStockAlert Boolean     @default(false)
  orderItems      OrderItem[]

  @@unique([productId, size, color])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  externalId      String?       @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerEmail   String?
  customerName    String
  customerPhone   String        @default("")
  region          String        @default("")
  city            String        @default("")
  notes           String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)
  subtotal        Float         @default(0)
  deliveryFee     Float         @default(0)
  total           Float
  shippingAddress String
  locale          String        @default("en")
  source          OrderSource   @default(WEB)
  /// Hub id of the order in the 7.10 desktop pipeline once a laptop has taken it in
  desktopRef      String?
  /// Laptop (SyncDevice id) currently bringing the order into the desktop app
  claimedBy       String?
  claimedAt       DateTime?
  /// Why the desktop app couldn't take the order in (e.g. product not linked)
  syncError       String?
  syncedAt        DateTime?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  contact   String   @unique
  locale    String   @default("en")
  createdAt DateTime @default(now())
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Float
}

model Comment {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName  String
  authorEmail String
  content     String
  reply       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductRequest {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  memberId  String
  member    User          @relation("MemberRequests", fields: [memberId], references: [id], onDelete: Cascade)
  managerId String?
  manager   User?         @relation("ManagerRequests", fields: [managerId], references: [id], onDelete: SetNull)
  message   String
  response  String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model StockNotification {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, email])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// A laptop running the 7.10 desktop app, linked to this shop's cloud hub.
model SyncDevice {
  id         String    @id
  name       String
  tokenHash  String
  /// Last hub change this laptop has applied (used for pruning the change log)
  cursor     Int       @default(0)
  appVersion String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?
}

/// Append-only log of every change pushed by a laptop. `seq` is the global order all laptops replay.
model SyncChange {
  seq       Int      @id @default(autoincrement())
  deviceId  String
  /// The laptop's own outbox number; makes retried pushes harmless
  clientSeq Int
  tbl       String
  gid       String
  /// U = upsert row, D = delete row, C = add to counter columns
  op        String
  data      String
  /// Unix ms; written with bulk SQL, so kept as a plain number
  at        Float

  @@unique([deviceId, clientSeq])
  @@index([at])
}

/// Latest state of each desktop row, used to hand a snapshot to a newly joined laptop and to build the storefront.
model SyncRow {
  tbl       String
  gid       String
  data      String
  deleted   Boolean  @default(false)
  seq       Int

  @@id([tbl, gid])
  @@index([tbl, deleted])
}

/// Running totals for counter columns (stock, balances). Laptops only ever send +/- amounts.
model SyncCounter {
  tbl   String
  gid   String
  col   String
  value Float  @default(0)

  @@id([tbl, gid, col])
}

model SyncMeta {
  key   String @id
  value String
}

/// Product photos and other files shared by the laptops and shown on the storefront.
model MediaFile {
  name        String   @id
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}

enum Role {
  CUSTOMER
  MANAGER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  CARD
  WHISH
}

enum OrderSource {
  WEB
  OTARGI
  APP
}

enum RequestStatus {
  PENDING
  REVIEWED
  CLOSED
}
