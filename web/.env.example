# Database — local file, or a Turso libsql:// URL in production (see HOSTING.md)
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=""

# NextAuth
AUTH_SECRET="generate-a-random-secret-here"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth (optional — https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (optional — Gmail / Google Workspace SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="7.10 Brand <orders@7-10.store>"

# Store admin notifications
ADMIN_EMAIL="admin@7-10.store"

# Low stock threshold
LOW_STOCK_THRESHOLD=5

# Desktop ↔ website hub — paste the same key into the desktop app (Settings → Cloud sync)
SHOP_SYNC_KEY="change-me-to-a-long-random-key"
# Older name still accepted if SHOP_SYNC_KEY is empty
OTARGI_API_KEY=""

# Storefront
# live = open for orders, soon = everyone sees the countdown page,
# auto = countdown until NEXT_PUBLIC_LAUNCH_AT, then live
STORE_MODE="live"
# Visit /soon?preview=<this key> once to browse the store while it is in "soon" mode
STORE_PREVIEW_KEY="change-me"
NEXT_PUBLIC_LAUNCH_AT="2026-10-07T00:00:00+03:00"
NEXT_PUBLIC_SITE_URL="https://7-10.store"
NEXT_PUBLIC_WHATSAPP="96170000000"
NEXT_PUBLIC_INSTAGRAM="7.10brand"
NEXT_PUBLIC_CONTACT_EMAIL="hello@7-10.store"

# Whish Money — from your Whish merchant account (not the customer app)
WHISH_CHANNEL=""
WHISH_SECRET=""
# Public HTTPS URL registered with Whish. Defaults to NEXT_PUBLIC_SITE_URL.
WHISH_WEBSITE_URL=""
# sandbox | production. Empty = sandbox in development, production when the site is live.
WHISH_ENV=""
