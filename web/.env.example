# Database
DATABASE_URL="file:./dev.db"

# NextAuth
AUTH_SECRET="generate-a-random-secret-here"
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Gmail / Google Workspace SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="orders@yourstore.com"
SMTP_PASS="your-app-password"
SMTP_FROM="7-10 Store <orders@yourstore.com>"

# Store admin notifications
ADMIN_EMAIL="admin@yourstore.com"

# Low stock threshold
LOW_STOCK_THRESHOLD=5

# Otargi desktop app sync (set a long random string)
OTARGI_API_KEY="change-me-to-a-long-random-key"
